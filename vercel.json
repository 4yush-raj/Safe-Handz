{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/login/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/dashboard/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/insurance-dashboard/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/auth/:path*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}